  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_003
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: What is understood by air-sickness?
  referenceImage: {fileID: 0}
  explanationText: Air-sickness occurs when there is a sensory conflict between the
    information provided by the eyes and the vestibular system (inner ear), particularly
    during motion such as in-flight maneuvers. This can lead to symptoms like nausea,
    vomiting, and disorientation.
  options:
  - An illness caused by an infection of the middle ear
  - An illness caused by reduced air pressure
  - A sensory conflict within the vestibular system accompanied by nausea, vomiting,
    and fear
  - An illness caused by evaporation of gases in the blood
  correctOptionIndex: 2
