  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_005
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: 'Excessive exposure to noise damages:'
  referenceImage: {fileID: 0}
  explanationText: Excessive exposure to loud noise can damage the sensitive membrane
    (basilar membrane) in the cochlea, which is responsible for converting sound
    vibrations into electrical signals that the brain can interpret. Prolonged exposure
    to high-decibel sounds can lead to permanent hearing loss.
  options:
  - The eardrum
  - The sensitive membrane in the cochlea
  - The semicircular canals
  - The ossicles
  correctOptionIndex: 1
