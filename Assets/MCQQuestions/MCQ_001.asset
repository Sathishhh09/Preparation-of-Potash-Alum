  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_001
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: Which part of the vestibular apparatus is responsible for the impression
    of angular acceleration?
  referenceImage: {fileID: 0}
  explanationText: The semicircular canals are responsible for detecting angular
    acceleration or rotational movements. They are part of the vestibular apparatus
    and help maintain balance by detecting head rotations in three planes (pitch,
    yaw, and roll).
  options:
  - The cochlea
  - The semicircular canals
  - The eustachian tube
  - The sacculus and utriculus
  correctOptionIndex: 1
