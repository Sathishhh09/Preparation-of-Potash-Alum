  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_003
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: Where is the pre-flight altimeter check made, and what is the maximum
    difference from the average elevation?
  referenceImage: {fileID: 0}
  explanationText: It belongs on the apron so it can be done before taxi clearance.
    No part may be more than 3 m, or 10 ft, from the average elevation.
  options:
  - On the runway, 5 m
  - On the apron, 3 m or 10 ft
  - On the taxiway, 1 m
  - At the ARP, 10 m
  correctOptionIndex: 1
