  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_005
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: For a code 4 precision approach runway, how far must the strip extend
    beyond the runway end, and how far each side of the centreline?
  referenceImage: {fileID: 0}
  explanationText: At least 60 m beyond the end for code 2, 3 and 4, and 150 m each
    side of the centreline for a code 3 or 4 precision or non-precision runway.
  options:
  - 30 m beyond, 75 m each side
  - 60 m beyond, 150 m each side
  - 90 m beyond, 150 m each side
  - 60 m beyond, 75 m each side
  correctOptionIndex: 1
