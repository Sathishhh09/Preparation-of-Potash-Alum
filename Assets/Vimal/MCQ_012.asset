  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_012
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: What is the only type of fixed object normally permitted inside a
    runway strip?
  referenceImage: {fileID: 0}
  explanationText: Visual aids are the exception, and they must be frangible. Everything
    else inside the stated dimensions is an obstacle.
  options:
  - Boundary fencing
  - Visual aids such as PAPIs, and they must be frangible
  - Maintenance vehicles
  - ILS localiser aerials
  correctOptionIndex: 1
