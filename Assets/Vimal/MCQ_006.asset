  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_006
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: What is the minimum RESA length from the end of the strip, and the
    recommended length for a code 3 or 4 runway?
  referenceImage: {fileID: 0}
  explanationText: Not less than 90 m is the standard. 240 m is the recommendation
    for code 3 and 4, and 120 m for code 1 and 2.
  options:
  - 60 m minimum, 120 m recommended
  - 90 m minimum, 240 m recommended
  - 90 m minimum, 120 m recommended
  - 120 m minimum, 240 m recommended
  correctOptionIndex: 1
