  m_Name: MCQ_011
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: How far from the runway centreline is the holding position for a
    precision CAT II runway, code 4?
  referenceImage: {fileID: 0}
  explanationText: 90 m for precision CAT I, II and III on code 3 and 4 runways.
    For code F that figure becomes 107.5 m.
  options:
  - 75 m
  - 90 m
  - 60 m
  - 107.5 m
  correctOptionIndex: 1
