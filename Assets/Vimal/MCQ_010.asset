  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_010
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: What is the required intersecting angle for a rapid exit taxiway,
    and the design turn-off speed in the wet on a code 4 runway?
  referenceImage: {fileID: 0}
  explanationText: Not more than 45 degrees, not less than 25, preferably 30. The
    design speed in the wet is 93 km/h, which is 50 kt, on code 3 and 4 runways.
  options:
  - 25 to 45 degrees, preferably 30. 93 km/h or 50 kt
  - 30 to 60 degrees, preferably 45. 65 km/h or 35 kt
  - Exactly 45 degrees. 93 km/h or 50 kt
  - 25 to 45 degrees, preferably 30. 65 km/h or 35 kt
  correctOptionIndex: 0
