  m_Name: MCQ_004
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: Which of the following mixtures is used to wash the crystals of potash
    alum formed during the experiment?
  referenceImage: {fileID: 0}
  explanationText: The crystals of potash alum are washed with a cold water-alcohol
    mixture to remove adhering impurities while minimizing the loss of alum crystals.
  options:
  - Cold water-alcohol mixture
  - Cold water-ammonia mixture
  - Alcohol-ammonia mixture
  - Alcohol-carboxylic acid mixture
  correctOptionIndex: 0
