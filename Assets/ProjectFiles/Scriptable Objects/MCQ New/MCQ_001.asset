  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: MCQ_001
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: What is the action of heat on potash alum?
  referenceImage: {fileID: 0}
  explanationText: The chemical formula of potash alum is KAl(SO<sub>4</sub>)<sub>2</sub>.12H<sub>2</sub>O.
    On heating its crystals moderately, it loses the water of crystallisation and
    then liquefy and becomes fluffy. If heating continues, the water is driven off
    and it gets converted into anhydrous powder of potassium aluminium sulphate [KAl(SO<sub>4</sub>)<sub>2</sub>].
  options:
  - It sublimes
  - It turns black when hot
  - It loses water of crystallisation
  - No effect
  correctOptionIndex: 2
